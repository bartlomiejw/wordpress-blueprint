{
    "$schema": "https://schemas.wp.org/trunk/wp-env.json",
    "core": "https://wordpress.org/wordpress-7.1.3.zip",
    "phpVersion": "8.3",
    "testsEnvironment": false,
    "themes": [
        "./wp-content/themes/custom-theme"
    ],
    "mappings": {
        "wp-content/mu-plugins": "./wp-content/mu-plugins"
    },
    "config": {
        "WP_DEBUG": true,
        "SCRIPT_DEBUG": true
    },
    "lifecycleScripts": {
        "afterStart": "wp-env run cli wp theme activate custom-theme"
    }
}
