{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "custom-theme/example-block",
    "version": "1.0.0",
    "title": "Example Block",
    "category": "theme",
    "description": "Scaffold block — rename, adapt, or delete.",
    "keywords": ["example"],
    "textdomain": "custom-theme",
    "supports": {
        "html": false,
        "align": ["wide", "full"]
    },
    "attributes": {
        "heading": {
            "type": "string",
            "default": ""
        },
        "content": {
            "type": "string",
            "default": ""
        }
    },
    "editorScript": "file:./index.js",
    "style": "file:./style-index.css",
    "render": "file:./render.php"
}