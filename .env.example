# Copy to .env and fill in values. Never commit .env.

# Database: DDEV injects these automatically; set manually for other envs.
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_HOST=db
DB_PREFIX=wp_

# Site URL: no trailing slash. Must match the DDEV site URL locally.
WP_HOME=https://site-project.ddev.site

# Environment type: local, development, staging or production.
WP_ENVIRONMENT_TYPE=local

# Debug: set to true for local development only.
WP_DEBUG=true
WP_DEBUG_LOG=true
WP_DEBUG_DISPLAY=false
SCRIPT_DEBUG=true
SAVEQUERIES=false

# Authentication keys & salts: generate at https://api.wordpress.org/secret-key/1.1/salt/
AUTH_KEY=replace-me
SECURE_AUTH_KEY=replace-me
LOGGED_IN_KEY=replace-me
NONCE_KEY=replace-me
AUTH_SALT=replace-me
SECURE_AUTH_SALT=replace-me
LOGGED_IN_SALT=replace-me
NONCE_SALT=replace-me

# Private plugin license keys
# ACF_PRO_KEY=your-key-here
# GRAVITY_FORMS_KEY=your-key-here