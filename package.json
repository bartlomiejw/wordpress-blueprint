{
    "name": "wordpress-blueprint",
    "version": "1.0.0",
    "private": true,
    "description": "Repository-level tooling: Git hooks, wp-env and Playwright end-to-end tests.",
    "license": "MIT",
    "scripts": {
        "prepare": "husky",
        "env:start": "wp-env start",
        "env:stop": "wp-env stop",
        "env:destroy": "wp-env destroy",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "lint:e2e": "npm exec --prefix wp-content/themes/custom-theme -- wp-scripts lint-js tests/e2e playwright.config.js"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.0",
        "@wordpress/env": "^12.0.0",
        "husky": "^9.1.7",
        "lint-staged": "^15.5.2"
    },
    "engines": {
        "node": ">=22"
    },
    "lint-staged": {
        "wp-content/**/*.php": [
            "vendor/bin/phpcs -q"
        ],
        "wp-content/**/*.{js,jsx,ts,tsx}": [
            "npm exec --prefix wp-content/themes/custom-theme -- wp-scripts lint-js"
        ],
        "wp-content/**/*.{css,scss}": [
            "npm exec --prefix wp-content/themes/custom-theme -- wp-scripts lint-style"
        ]
    }
}
